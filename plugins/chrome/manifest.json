{
  "manifest_version": 3,
  "name": "LunArcus",
  "version": "0.2.26",
  "description": "LunArcus Chrome Extension：OAuth PKCE、網頁與對話擷取、背景匯入 Queue",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://loc.lo3rwang.cc/*",
    "https://auth.lo3rwang.cc/*",
    "https://mcp.lo3rwang.cc/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "LunArcus",
    "default_icon": {
      "16": "icons/loc-favicon.png",
      "48": "icons/loc-favicon.png",
      "128": "icons/loc-favicon.png"
    }
  },
  "short_name": "LunArcus",
  "icons": {
    "16": "icons/loc-favicon.png",
    "48": "icons/loc-favicon.png",
    "128": "icons/loc-favicon.png"
  },
  "key": ""
}
