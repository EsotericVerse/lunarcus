{
  "$schema": "https://unpkg.com/wrangler@4.157.0/config-schema.json",
  "name": "lunarcus",
  "main": "./server/index.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true,
  "preview_urls": true
}
