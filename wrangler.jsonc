{
  "$schema": "https://unpkg.com/wrangler@4.157.0/config-schema.json",
  "name": "lunarcus",
  "main": "./server/worker.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./public",
    "binding": "LAS_ASSETS",
    "run_worker_first": [
      "/.well-known/security.txt"
    ]
  },
  "keep_vars": true,
  "previews": {},
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Auth's only PostgreSQL transport. Existing LAS_DATABASE_URL Secret is
  // retained during validation but is never used as an implicit fallback.
  "hyperdrive": [
    {
      "binding": "LAS_HYPERDRIVE",
      "id": "f80d2201f6344ccaa105d3fe47c8b518"
    }
  ],
  "containers": [
    {
      "class_name": "PluginImportContainer",
      "image": "./containers/plugin-import/Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LAS_PLUGIN_IMPORT",
        "class_name": "PluginImportContainer"
      }
    ]
  },
  "exports": {
    "PluginImportContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // workers.dev is for version/branch Preview URLs only, never production.
  "workers_dev": false,
  "preview_urls": true,
  // Production entrypoints are the stable Auth/MCP custom domains only.
  "routes": [
    {
      "pattern": "auth.lo3rwang.cc",
      "custom_domain": true,
      "zone_name": "lo3rwang.cc",
      "previews_enabled": false
    },
    {
      "pattern": "mcp.lo3rwang.cc",
      "custom_domain": true,
      "zone_name": "lo3rwang.cc",
      "previews_enabled": false
    }
  ]
}
